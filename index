.tag{display:inline-block;font-size:10px;letter-spacing:.1em;text-transform:uppercase;border-radius:4px;padding:1px 7px;margin-right:9px;vertical-align:2px;border:1px solid}.tag.E{color:#6fd3a0}.tag.H{color:var(--ac2)}.tag.S{color:#e0a96d}
.gbox{background:var(--pn);border:1px solid var(--ln);border-radius:14px;padding:8px;margin-bottom:32px}.gbox svg{width:100%;height:auto;max-height:520px;display:block}
.gbox text{fill:var(--mu);font-size:11px;text-anchor:middle}.gbox a:hover text{fill:var(--tx)}.gbox circle{transition:r .2s}.gbox a:hover circle{r:12}
.src{color:var(--mu);font-size:14px;padding-left:18px}.crumb:hover{text-decoration:underline}
.empty{color:var(--mu);border:1px dashed var(--ln);border-radius:14px;padding:28px;text-align:center}
#sur{position:fixed;right:max(18px,env(safe-area-inset-right,0px));bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:25;box-shadow:0 10px 30px #000a}
