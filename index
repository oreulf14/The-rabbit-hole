<script>
const D=[
{id:"voynich",t:"The Voynich Manuscript",c:"Unsolved Mysteries",d:"A 15th-century book in a script nobody can read, full of plants nobody can identify.",r:["kryptos","cicada","gobekli"],
a:[["E","The Voynich Manuscript is held at Yale’s Beinecke Library as MS 408. Its roughly 240 vellum pages are filled with an unknown script and illustrations of unidentified plants, star charts and bathing figures. Radiocarbon testing in 2009 dated the vellum to 1404–1438."],["E","It is named for Wilfrid Voynich, the book dealer who acquired it in 1912. No reading of the text has been accepted by scholars, despite attempts by professional codebreakers."],["H","Leading ideas include an enciphered natural language, a constructed language, or an elaborate hoax. Word-frequency patterns resemble real language, which is one reason a purely random hoax is debated."]],
f:["Dated to the early 1400s by radiocarbon testing.","Yale holds it as MS 408."],s:["Yale Beinecke Library, MS 408 catalogue record","University of Arizona radiocarbon dating report (2009)"]},
{id:"wow",t:"The Wow! Signal",c:"Space",d:"Seventy-two seconds of a strong radio signal from Sagittarius that never came back.",r:["tunguska","bloop","taos"],
a:[["E","On 15 August 1977 the Big Ear radio telescope at Ohio State University recorded a strong narrowband signal near 1420 MHz, the hydrogen line. Astronomer Jerry Ehman circled the data on the printout and wrote “Wow!” beside it."],["E","The signal lasted about 72 seconds, matching the time the sky drift carried the source through the telescope’s beam. Repeated searches have not found it again."],["H","Explanations range from a one-off natural source to a transmission of artificial origin. A 2017 proposal blaming hydrogen clouds around comets has been disputed by other astronomers."]],
f:["Frequency sat close to the hydrogen line, 1420 MHz.","Big Ear was demolished in 1998."],s:["Ohio State University Radio Observatory records","NASA SETI background material"]},
{id:"taos",t:"The Taos Hum",c:"Unsolved Mysteries",d:"A low droning sound heard by some residents of a New Mexico town, and by no microphone.",r:["bloop","dancing"],
a:[["E","From the early 1990s, residents of Taos, New Mexico, reported a persistent low-frequency hum. A survey of the area found roughly two percent of respondents said they heard it."],["E","Teams including researchers from Los Alamos and Sandia National Laboratories investigated and could not link the sound to a measurable source."],["H","Proposed explanations include unusual sensitivity to faint low-frequency noise and tinnitus-like effects. None has been confirmed. Similar “Hum” reports exist elsewhere, including Bristol, England."]],
f:["Only a minority of locals hear it.","Instruments have found no matching source."],s:["Mullins & Kelly, Taos Hum survey (1995)","Los Alamos / Sandia investigation reports"]},
{id:"dancing",t:"The Dancing Plague of 1518",c:"Unusual Events",d:"In Strasbourg, dozens of people danced for days, some until they collapsed.",r:["capgras","maryceleste"],
a:[["E","In July 1518 a woman, often named as Frau Troffea, began dancing in a Strasbourg street. Over following weeks many others joined. City and medical records of the time confirm an outbreak of compulsive dancing."],["H","The old theory of ergot poisoning is doubted by historians such as John Waller, since ergot does not produce sustained coordinated dancing."],["H","The leading modern view is mass psychogenic illness, triggered by extreme stress from famine, disease and desperate belief in saints."],["S","Claims about exact death tolls are uncertain, as records are thin."]],
f:["It happened in the Holy Roman Empire, now France.","Waller wrote a full study in 2008."],s:["John Waller, A Time to Dance, a Time to Die (2008)","Strasbourg city council chronicles, as cited by Waller"]},
{id:"antikythera",t:"The Antikythera Mechanism",c:"Technology",d:"An ancient Greek gear-driven device that tracked the heavens, found in a shipwreck.",r:["voynich","gobekli","kryptos"],
a:[["E","Sponge divers found the wreck near the Greek island of Antikythera in 1900, and the corroded fragments were recognised in 1901. They are now at the National Archaeological Museum, Athens."],["E","X-ray imaging showed a train of bronze gears modelling the Sun and Moon’s cycles and predicting eclipses. It dates to roughly the 2nd–1st century BCE."],["E","No device of comparable mechanical complexity is known from the following millennium or more."],["H","Its builders and its purpose, such as teaching versus calculation, are still debated."]],
f:["Fragments are in 82 pieces.","Eclipse prediction is built in."],s:["Antikythera Mechanism Research Project","Freeth et al., Nature (2006)"]},
{id:"deepsea",t:"The Deep Sea’s Most Unusual Creatures",c:"Nature",d:"Below 200 metres, sunlight fades and life gets strange.",r:["bloop","kola"],
a:[["E","The ocean’s deepest point, Challenger Deep, is about 10,900 metres down. Most of the deep sea is dark, cold and under immense pressure, yet it supports abundant life."],["E","Many deep animals make their own light through bioluminescence. In some anglerfish species, tiny males bite onto a female and fuse to her."],["E","A giant squid was first filmed in its natural habitat in 2012, off Japan’s Ogasawara Islands."],["S","Scientists expect many deep-sea species are still undescribed, but how many is uncertain."]],
f:["Light fades to nothing below about 1,000 m.","Giant squid footage: 2012."],s:["NOAA Ocean Exploration","Smithsonian Ocean Portal"]},
{id:"tunguska",t:"The Tunguska Event",c:"Unusual Events",d:"In 1908 something exploded over Siberia and flattened millions of trees without leaving a crater.",r:["wow","maryceleste"],
a:[["E","On 30 June 1908 a huge explosion occurred above the Podkamennaya Tunguska River region of Siberia. An estimated 80 million trees were flattened across roughly 2,000 square kilometres."],["E","Leonid Kulik led the first scientific expeditions in the 1920s and found no impact crater."],["H","The prevailing view is an airburst of a stony asteroid or comet fragment several kilometres above the ground, which would explain the missing crater."],["S","Theories involving antimatter or alien craft are not supported by evidence."]],
f:["About 2,000 km² of forest destroyed.","Kulik’s expedition came in 1927."],s:["NASA Planetary Defense Coordination Office","Encyclopaedia Britannica: Tunguska event"]},
{id:"kryptos",t:"Kryptos",c:"Unsolved Mysteries",d:"A sculpture outside the CIA carries a code, and one part has resisted everyone.",r:["cicada","voynich"],
a:[["E","Kryptos was created by artist Jim Sanborn and installed at CIA headquarters in Langley, Virginia, in 1990. It carries four coded passages, known as K1 to K4."],["E","The first three were solved by the late 1990s. The fourth, K4, has only 97 characters and remains unsolved."],["E","Sanborn has released a few clues over the years, and has said the solution is not what many people expect."]],
f:["K4 is 97 characters long.","Sanborn worked with a retired CIA cryptographer."],s:["CIA: Kryptos page","Jim Sanborn interviews, various"]},
{id:"maryceleste",t:"The Mary Celeste",c:"History",d:"A seaworthy ship found drifting in 1872 with nobody aboard.",r:["dancing","bloop"],
a:[["E","On 4 December 1872 the crew of the Dei Gratia found the brigantine Mary Celeste adrift in the Atlantic. The captain, Benjamin Briggs, his family and the crew were gone, with the lifeboat missing."],["E","The ship was still seaworthy and carried industrial alcohol. A Gibraltar inquiry found no proof of foul play."],["H","A leading idea is that Briggs feared an explosion from fumes and ordered everyone into the lifeboat. This remains unproven."],["E","Much of the legend, including missing meals on the table, comes from a fictional 1884 story by Arthur Conan Doyle."]],
f:["Crew of ten were aboard when it left.","Fiction later embroidered the tale."],s:["Gibraltar Vice-Admiralty Court records","Brian Hicks, Ghost Ship (2004)"]},
{id:"gobekli",t:"Göbekli Tepe",c:"History",d:"Carved stone temples built around 11,500 years ago, before farming took hold.",r:["antikythera","voynich"],
a:[["E","Göbekli Tepe, in southeastern Turkey, has T-shaped limestone pillars up to about 5.5 metres tall, many carved with animals. It dates to roughly 9500 BCE."],["E","Excavations led by Klaus Schmidt of the German Archaeological Institute began in 1995. UNESCO listed it as a World Heritage site in 2018."],["H","It was probably a ritual or ceremonial site. Whether people lived there permanently is still debated."]],
f:["Older than Stonehenge by thousands of years.","It predates writing and metal tools."],s:["UNESCO World Heritage listing","German Archaeological Institute excavation reports"]},
{id:"mpemba",t:"The Mpemba Effect",c:"Science",d:"Can hot water freeze faster than cold? A schoolboy in Tanzania asked.",r:["kola","deepsea"],
a:[["E","In the 1960s Tanzanian student Erasto Mpemba noticed that hot ice-cream mix froze faster than cooler mix. He and physicist Denis Osborne published a paper in 1969."],["H","Some experiments report the effect, others do not, and results depend on conditions. Ideas include evaporation, convection, supercooling and dissolved gases."],["S","Whether it is one phenomenon at all is unresolved, and there is no consensus on its cause."]],
f:["Observers go back to Aristotle.","Results vary between labs."],s:["Mpemba & Osborne, Physics Education (1969)","Burridge & Linden, Scientific Reports (2016)"]},
{id:"kola",t:"The Kola Superdeep Borehole",c:"Geography",d:"The deepest hole humans ever dug, and the heat it found.",r:["deepsea","mpemba","gobekli"],
a:[["E","The Soviet Union began drilling on the Kola Peninsula in 1970. In 1989 it reached 12,262 metres, still the deepest artificial point on Earth. Drilling stopped in 1992."],["E","Temperatures at the bottom were far hotter than expected, around 180°C, and the rock held unexpected water."],["E","The story of recordings of “screams from hell” is a hoax, not a finding."]],
f:["Wider than a manhole at the top.","Deeper than Challenger Deep’s depth."],s:["Kozlovsky, Kola Superdeep Borehole (scientific review)","Encyclopaedia Britannica"]},
{id:"capgras",t:"The Capgras Delusion",c:"Psychology",d:"The conviction that someone you love has been replaced by an identical impostor.",r:["dancing","maxheadroom"],
a:[["E","Described in 1923 by French psychiatrist Joseph Capgras, the delusion involves believing a familiar person has been replaced by a double. It is linked to some neurological and psychiatric conditions."],["H","A prominent theory, from Ellis and Young, proposes that face recognition stays intact while the usual emotional response is lost, so the person feels “wrong”."],["E","Neurologist V. S. Ramachandran helped popularise this account."]],
f:["First reported in 1923.","Can follow brain injury."],s:["Ellis & Young, British Journal of Psychiatry (1990)","Ramachandran, Phantoms in the Brain (1998)"]},
{id:"cicada",t:"Cicada 3301",c:"The Internet",d:"A series of anonymous puzzles that recruited codebreakers across the web.",r:["kryptos","maxheadroom"],
a:[["E","In January 2012 an anonymous image appeared on 4chan with a challenge. Solving it led through steganography, cryptography and real-world locations. Further rounds followed in 2013 and 2014."],["E","The group behind it has never been conclusively identified, and its stated aim of finding intelligent people is unverified."],["S","Rumours that intelligence agencies or secret societies ran it are speculation."]],
f:["Rounds ran in 2012, 2013 and 2014.","A signed key tied later messages together."],s:["Wired: Cicada 3301 coverage","Contemporary puzzle write-ups by participants"]},
{id:"maxheadroom",t:"The Max Headroom Broadcast Hijacking",c:"The Internet",d:"A masked intruder took over two Chicago TV stations in 1987, and was never caught.",r:["cicada","taos"],
a:[["E","On 22 November 1987 a signal intrusion hijacked Chicago station WGN for about 25 seconds during a sports segment. Hours later it seized WTTW during Doctor Who."],["E","A person in a Max Headroom mask appeared. The FCC investigated, and the perpetrator has never been publicly identified."],["E","The incident exposed how weakly broadcast links were protected at the time."]],
f:["Two stations hit the same night.","No arrests have been made."],s:["Chicago Tribune archive reports","FCC investigation summaries"]},
{id:"bloop",t:"The Bloop",c:"Nature",d:"An enormous ocean sound that hydrophones picked up in 1997.",r:["deepsea","wow"],
a:[["E","In 1997 NOAA hydrophones in the Pacific recorded an ultra-low-frequency sound that rose for about a minute. It was loud enough to be heard across thousands of kilometres. Researchers named it the Bloop."],["E","NOAA scientists later concluded it was most likely an icequake from a large iceberg fracturing, matching signals seen in Antarctica."],["S","Giant sea monster stories are not supported by evidence."]],
f:["Detected by multiple sensors.","Source traced to ice."],s:["NOAA Pacific Marine Environmental Laboratory","NOAA Ocean Explorer: Bloop FAQ"]},
{id:'emu',t:'The Great Emu War',c:'Unusual Events',d:'In 1932 the Australian military went to war with emus and did not clearly win.',r:['tunguska','maryceleste'],a:[['E','In late 1932, farmers in Western Australia asked for help against large numbers of emus trampling crops. Soldiers led by Major G. P. W. Meredith were sent with Lewis machine guns.'],['E','The emus scattered in small groups and were hard to hit. The operation was withdrawn after limited success, and a bounty scheme was used later.'],['S','Accounts of exact kill counts vary, so treat any precise number with caution.']],f:['It took place in November and December 1932.','The military acted at farmers’ request.'],s:['Australian War Memorial','National Archives of Australia']},
{id:'gage',t:'Phineas Gage',c:'Psychology',d:'A railroad foreman survived an iron rod through his skull and became a case study in neuroscience.',r:['capgras','kola'],a:[['E','On 13 September 1848, Vermont railroad foreman Phineas Gage was packing blasting powder when an explosion drove an iron tamping rod, about 1.1 metres long, through his left cheek and out of the top of his skull.'],['E','He survived and lived about twelve more years, dying in 1860.'],['H','Contemporary accounts say his personality changed. Later retellings exaggerated this, and historians argue the evidence is thinner than often claimed.']],f:['The rod was about 1.1 m long.','His skull and the rod are held at Harvard’s Warren Anatomical Museum.'],s:['Macmillan, An Odd Kind of Fame (2000)','Harvard Warren Anatomical Museum']},
{id:'seedvault',t:'The Svalbard Global Seed Vault',c:'Nature',d:'A frozen backup of the world’s crops, tunnelled into an Arctic mountain.',r:['kola','deepsea','gobekli'],a:[['E','The Svalbard Global Seed Vault, on Norway’s Spitsbergen island, opened in 2008 as a backup store for the world’s crop seed collections. Gene banks deposit duplicates and keep ownership of them.'],['E','In 2015 the first withdrawal was made by a research centre whose seed collection in Syria was endangered by the civil war. In 2017 meltwater entered the entrance tunnel but did not reach the seeds.']],f:['Built into permafrost rock.','It is a backup, not an original collection.'],s:['Crop Trust','Norwegian Ministry of Agriculture and Food']},
{id:'fermi',t:'The Fermi Paradox',c:'Space',d:'If the universe is so big, where is everybody?',r:['wow','tunguska'],a:[['E','Physicist Enrico Fermi is credited with asking at a 1950 lunch at Los Alamos why we see no sign of other civilisations if intelligent life is common. In 1961 Frank Drake framed the question as an equation of factors estimating how many might be detectable.'],['H','Proposed answers include that life or intelligence is rare, that a “Great Filter” stops civilisations becoming detectable, or that we have not searched enough of the sky.'],['S','Whether the silence is meaningful at all is unknown.']],f:['The Drake equation dates to 1961.','The Wow! Signal is a famous candidate.'],s:['SETI Institute','Robin Hanson, The Great Filter essay']},
{id:'piltdown',t:'The Piltdown Man',c:'History',d:'A “missing link” that fooled scientists for about forty years.',r:['voynich','gobekli'],a:[['E','In 1912 Charles Dawson announced fragments from a gravel pit at Piltdown, England, as a missing link between apes and humans.'],['E','In 1953 tests by Kenneth Oakley, Joseph Weiner and Wilfrid Le Gros Clark showed it was a medieval human skull paired with an orangutan jaw, stained to look ancient.'],['H','Many suspect Dawson, but who did it has never been proven.']],f:['The hoax stood for about 40 years.','Fluorine testing helped expose it.'],s:['Natural History Museum, London','Weiner, The Piltdown Forgery (1955)']},
{id:'oumuamua',t:'ʻOumuamua',c:'Space',d:'The first known interstellar visitor to our solar system, and it behaved oddly.',r:['wow','fermi','tunguska'],a:[['E','Detected in October 2017 by the Pan-STARRS telescope in Hawaii, ʻOumuamua was the first known interstellar object seen passing through our solar system.'],['E','It was oddly elongated or flat, and it sped up slightly as it left, in a way not explained by gravity alone.'],['H','Most astronomers favour natural explanations, such as outgassing of hydrogen ice (proposed in 2023). Harvard’s Avi Loeb has argued it could be artificial, a view most researchers reject.']],f:['First confirmed interstellar visitor.','Its name is Hawaiian, often glossed as “scout”.'],s:['NASA Solar System Exploration','Bergner & Seligman, Nature (2023)']},
{id:'roanoke',t:'The Lost Colony of Roanoke',c:'History',d:'A whole English colony vanished in the 1580s, leaving one carved word.',r:['maryceleste','gobekli'],a:[['E','In 1587 about 115 English colonists settled on Roanoke Island, in what is now North Carolina. Governor John White sailed home for supplies and, delayed by war with Spain, returned in 1590.'],['E','He found the settlement dismantled and the word CROATOAN carved on a post. No sign of the colonists was found.'],['H','Many historians think they joined nearby Native groups or moved elsewhere. The evidence is circumstantial.']],f:['Virginia Dare was born there in 1587.','Archaeology at the site continues.'],s:['National Park Service: Fort Raleigh','First Colony Foundation']},
{id:'toynbee',t:'The Toynbee Tiles',c:'The Internet',d:'Mysterious tiles in city streets urge you to resurrect the dead on Jupiter.',r:['cicada','maxheadroom'],a:[['E','Since the 1980s, small linoleum tiles carrying a cryptic message about resurrecting the dead on Jupiter have appeared embedded in streets, mainly in US cities.'],['E','The 2011 documentary Resurrect Dead followed the search for the maker. It proposed a likely creator, but that is not universally accepted.'],['S','Theories about the meaning behind the message remain speculation.']],f:['The text nods to Kubrick’s 2001.','Found in cities across the Americas.'],s:['Resurrect Dead (2011, dir. Jon Foy)','Contemporary newspaper reports']},
{id:'mandela',t:'The Mandela Effect',c:'Psychology',d:'Why thousands of people remember something that never happened.',r:['capgras','cicada'],a:[['E','The term was coined around 2009 by Fiona Broome, who found that she and others remembered Nelson Mandela dying in prison in the 1980s. He died in 2013.'],['H','Psychologists explain such shared errors through false memory, suggestion and reconstruction of memories, rather than alternate universes.'],['E','A common example is the children’s book series spelled Berenstain, often misremembered as Berenstein.'],['S','Parallel-universe explanations have no evidence.']],f:['Memory is reconstructive.','Shared errors can be common.'],s:['Elizabeth Loftus, research on false memory','Fiona Broome’s original site']},
{id:'nyos',t:'The Lake Nyos Disaster',c:'Geography',d:'A silent cloud of gas rose from a crater lake and killed villages in 1986.',r:['kola','tunguska'],a:[['E','On 21 August 1986 Lake Nyos in Cameroon suddenly released a huge cloud of carbon dioxide that flowed into nearby valleys. It killed about 1,700 people and many livestock, some in villages around 25 km away.'],['E','The gas had built up dissolved in the deep water of the crater lake. Since 2001, degassing pipes have been installed to release it safely.']],f:['Called a limnic eruption.','Lake Monoun had a smaller event in 1984.'],s:['USGS: Lake Nyos','Kling et al., Science (1987)']},
{id:'pitch',t:'The Pitch Drop Experiment',c:'Science',d:'The longest-running lab experiment on Earth is a funnel of very slow tar.',r:['mpemba','kola'],a:[['E','The pitch drop experiment began in 1927 at the University of Queensland, when Thomas Parnell set pitch to drip through a funnel. Pitch seems solid but is extremely viscous, roughly 100 billion times thicker than water.'],['E','Drops fall roughly every eight to fourteen years, and it is recognised as the world’s longest-running continuing laboratory experiment.']],f:['Started in 1927.','Pitch looks like a brittle solid.'],s:['University of Queensland, School of Mathematics and Physics','Guinness World Records']},
{id:'eliza',t:'ELIZA',c:'Technology',d:'In 1966 a simple chatbot convinced people it understood them.',r:['capgras','antikythera'],a:[['E','In 1966 MIT computer scientist Joseph Weizenbaum published ELIZA, a program whose DOCTOR script imitated a Rogerian therapist by turning users’ statements back into questions.'],['E','People often attributed real understanding to it, which Weizenbaum found alarming. The tendency is now called the ELIZA effect.']],f:['It used simple pattern matching.','Weizenbaum later became a critic of such uses.'],s:['Weizenbaum, ELIZA, Communications of the ACM (1966)','Weizenbaum, Computer Power and Human Reason (1976)']},
{id:'rongo',t:'Rongorongo',c:'Unsolved Mysteries',d:'The undeciphered glyphs of Easter Island.',r:['voynich','kryptos','gobekli'],a:[['E','Rongorongo is a set of glyphs carved on wooden objects from Rapa Nui (Easter Island), with about two dozen inscribed pieces surviving. Missionaries noticed them in the 1860s.'],['E','It remains undeciphered.'],['H','Whether it is true writing or a memory aid for recitation is debated.']],f:['Roughly two dozen objects survive.','Its age is uncertain.'],s:['Barthel, Grundlagen zur Entzifferung der Osterinselschrift (1958)','Fischer, Rongorongo: The Easter Island Script (1997)']}
];
const CATS=["Unsolved Mysteries","History","Science","Psychology","Technology","Space","Nature","Geography","The Internet","Unusual Events"],TAG={E:"Established",H:"Hypothesis",S:"Speculation"};
const $=s=>document.querySelector(s),slug=c=>"cat-"+c.toLowerCase().replace(/ /g,"-");
const store={get(k,d){try{return JSON.parse(localStorage.getItem(k))??d}catch(e){return d}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}};
let bm=store.get("rh_bm",[]),hist=store.get("rh_hist",[]);
const byId=Object.fromEntries(D.map(x=>[x.id,x]));
const rel=id=>[...new Set([...byId[id].r,...D.filter(x=>x.r.includes(id)).map(x=>x.id)])].filter(r=>byId[r]);
const uniq=a=>[...new Set(a)];

function art(id,h=150){let s=0;for(const c of id)s=(s*31+c.charCodeAt(0))>>>0;const r=()=>(s=(s*1664525+1013904223)>>>0)/4294967296,hue=230+Math.floor(r()*70),p=[];
for(let i=0;i<14;i++)p.push([r()*400,r()*h]);
let o=`<svg viewBox="0 0 400 ${h}" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Abstract artwork"><rect width="400" height="${h}" fill="#101219"/>`;
p.forEach((a,i)=>{const b=p[(i*5+3)%14];o+=`<line x1="${a[0]}" y1="${a[1]}" x2="${b[0]}" y2="${b[1]}" stroke="hsl(${hue} 70% 65% / .35)"/>`});
p.forEach(a=>o+=`<circle cx="${a[0]}" cy="${a[1]}" r="${2+r()*7}" fill="hsl(${hue} 80% 70% / ${.3+r()*.5})"/>`);return o+"</svg>"}
const card=x=>`<a class="card" href="#${x.id}">${art(x.id)}<div><small>${x.c}</small><h3>${x.t}</h3><p>${x.d}</p></div></a>`;

function graph(id){const nb=rel(id),vis=uniq(hist.slice().reverse()).filter(x=>x!==id&&byId[x]).slice(0,6),outer=vis.filter(v=>!nb.includes(v));
const nodes=[{id,x:0,y:0,k:"cur"}],ring=(arr,R,off)=>arr.forEach((n,i)=>{const a=off+i/arr.length*6.2832;nodes.push({id:n,x:Math.cos(a)*R,y:Math.sin(a)*R,k:vis.includes(n)?"vis":"nb"})});
ring(nb,120,-1.57);ring(outer,205,-1.17);
const pos=Object.fromEntries(nodes.map(n=>[n.id,n])),E=new Set(nb.map(n=>id+">"+n));
for(let i=1;i<hist.length;i++)if(pos[hist[i-1]]&&pos[hist[i]]&&hist[i-1]!==hist[i])E.add(hist[i-1]+">"+hist[i]);
const col={cur:"#8b7cff",vis:"#4f8cff",nb:"#555b6e"};
return `<svg viewBox="-270 -240 540 480" role="group" aria-label="Exploration graph">`+
[...E].map(e=>{const[a,b]=e.split(">");return `<line x1="${pos[a].x}" y1="${pos[a].y}" x2="${pos[b].x}" y2="${pos[b].y}" stroke="#3a3f52"/>`}).join("")+
nodes.map(n=>{const t=byId[n.id].t.replace(/^The /,""),l=t.length>22?t.slice(0,21)+"…":t;return `<a href="#${n.id}"><circle cx="${n.x}" cy="${n.y}" r="${n.k==="cur"?15:9}" fill="${col[n.k]}"/><text x="${n.x}" y="${n.y+(n.k==="cur"?30:23)}">${l}</text></a>`}).join("")+
`<g font-size="10" fill="#8b90a0"><circle cx="-255" cy="215" r="5" fill="#8b7cff"/><text x="-246" y="219" style="text-anchor:start">You are here</text><circle cx="-255" cy="232" r="5" fill="#4f8cff"/><text x="-246" y="236" style="text-anchor:start">Visited</text><circle cx="-160" cy="215" r="5" fill="#555b6e"/><text x="-151" y="219" style="text-anchor:start">Connected</text></g></svg>`}

function home(){const feat=["voynich","wow","taos","dancing","antikythera","deepsea"],tr=D.slice().sort((a,b)=>rel(b.id).length-rel(a.id).length).slice(0,6);
return `<div class="pg"><div class="hero"><canvas id="cv"></canvas><div class="wrap"><h1>Curiosity has no bottom.</h1><p>Every discovery links to three more. Start with an unexplained signal, a lost manuscript or a sound in the ocean, then follow the connections and see where you land.</p><button class="btn" id="enter">Enter the Rabbit Hole</button></div></div>
<div class="wrap"><section><div class="eye">Featured</div><h2>Start somewhere strange</h2><div class="grid">${feat.map(i=>card(byId[i])).join("")}</div></section>
<section><div class="eye">Trending</div><h2>Trending rabbit holes</h2><div class="rank">${tr.map((x,i)=>`<a href="#${x.id}"><b>0${i+1}</b><h3>${x.t}</h3><span>${rel(x.id).length} connections</span></a>`).join("")}</div></section>
<section><div class="eye">Browse</div><h2>Pick a door</h2><div class="chips">${CATS.map(c=>`<a class="chip" href="#${slug(c)}">${c}</a>`).join("")}</div></section></div></div>`}
function list(title,eye,items,empty){return `<div class="pg wrap"><section><div class="eye">${eye}</div><h2>${title}</h2>${items.length?`<div class="grid">${items.map(card).join("")}</div>`:`<div class="empty">${empty}</div>`}</section></div>`}
function cats(){return `<div class="pg wrap"><section><div class="eye">Categories</div><h2>Ten doors</h2><div class="grid">${CATS.map(c=>{const n=D.filter(x=>x.c===c).length;return `<a class="card" href="#${slug(c)}"><div><small>${n} discover${n===1?"y":"ies"}</small><h3>${c}</h3></div></a>`}).join("")}</div></section></div>`}
function collection(){const seen=uniq(hist.slice().reverse()).filter(i=>byId[i]),sv=bm.filter(i=>byId[i]);
return `<div class="pg wrap"><section><div class="eye">My Collection</div><h2>Saved (${sv.length})</h2>${sv.length?`<div class="grid">${sv.map(i=>card(byId[i])).join("")}</div>`:`<div class="empty">Nothing saved yet. Use “Save to collection” on any discovery.</div>`}</section>
<section><h2>History (${seen.length} of ${D.length} explored)</h2>${seen.length?`<div class="grid">${seen.map(i=>card(byId[i])).join("")}</div><p><button class="btn g" data-clear="hist">Clear history</button> ${sv.length?`<button class="btn g" data-clear="bm">Clear saved</button>`:""}</p>`:`<div class="empty">Your trail will appear here as you explore.</div>`}</section></div>`}
function page(id){const x=byId[id],R=rel(id);
return `<article class="pg wrap art"><a class="crumb" href="#${slug(x.c)}">${x.c}</a><h1>${x.t}</h1><p class="lead">${x.d}</p><div class="himg">${art(id,260)}</div>
<div class="cols"><div>${x.a.map(([k,t])=>`<p><span class="tag ${k}">${TAG[k]}</span>${t}</p>`).join("")}</div>
<aside><h4>Quick facts</h4><ul>${x.f.map(f=>`<li>${f}</li>`).join("")}</ul><button class="btn" data-bm="${id}">${bm.includes(id)?"✓ Saved":"+ Save to collection"}</button></aside></div>
<section><div class="eye">Keep falling</div><h2>Where this leads</h2><div class="grid">${R.map(r=>card(byId[r])).join("")}</div></section>
<section><div class="eye">Exploration graph</div><h2>Your path</h2><div class="gbox">${graph(id)}</div></section>
<section><div class='eye'>Beyond the archive</div><h2>Not enough?</h2><button class='btn g' data-live='${encodeURIComponent(x.t)}'>Dive deeper on Wikipedia →</button></section><h4>Sources &amp; references</h4><ul class="src">${x.s.map(s=>`<li>${s}</li>`).join("")}</ul></article>`}

function bg(c){const g=c.getContext("2d");let W,H,P;const fit=()=>{W=c.width=c.offsetWidth;H=c.height=c.offsetHeight;P=Array.from({length:Math.min(70,W/16|0)},()=>({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.35,vy:(Math.random()-.5)*.35}))};fit();addEventListener("resize",fit);
const still=matchMedia("(prefers-reduced-motion:reduce)").matches;
(function f(){if(!c.isConnected)return;g.clearRect(0,0,W,H);P.forEach(p=>{p.x=(p.x+p.vx+W)%W;p.y=(p.y+p.vy+H)%H;g.fillStyle="rgba(139,124,255,.8)";g.fillRect(p.x,p.y,2.5,2.5)});
for(let i=0;i<P.length;i++)for(let j=i+1;j<P.length;j++){const d=Math.hypot(P[i].x-P[j].x,P[i].y-P[j].y);if(d<120){g.strokeStyle=`rgba(139,124,255,${.22*(1-d/120)})`;g.beginPath();g.moveTo(P[i].x,P[i].y);g.lineTo(P[j].x,P[j].y);g.stroke()}}
if(!still)requestAnimationFrame(f)})()}

const esc=s=>String(s).replace(/[&<>']/g,m=>'&#'+m.charCodeAt(0)+';');const WK='https://en.wikipedia.org/';let live=store.get('rh_live',null);const loadMsg=()=>`<div class='pg wrap'><section><div class='eye'>Deep Dive</div><h2>Digging…</h2></section></div>`;async function liveView(){const my=location.hash,app=$('#app'),wj=async u=>{const r=await fetch(u);if(!r.ok)throw new Error(r.status);return r.json()};try{const s=await wj(WK+(live?'api/rest_v1/page/summary/'+encodeURIComponent(live.t):'api/rest_v1/page/random/summary'));const m=await wj(WK+'w/api.php?action=query&list=search&srsearch='+encodeURIComponent('morelike:'+s.title)+'&srlimit=9&format=json&origin=*');if(location.hash!==my)return;live={t:s.title};store.set('rh_live',live);const L=m.query.search.map(x=>x.title).filter(t=>t!==s.title);app.innerHTML=`<article class='pg wrap art'><span class='crumb'>Deep Dive · Live from Wikipedia</span><h1>${esc(s.title)}</h1>${s.description?`<p class='lead'>${esc(s.description)}</p>`:''}<div class='himg' id='lim'>${art(s.title,260)}</div><div class='cols'><div><p>${esc(s.extract||'No summary available.')}</p><p><a class='crumb' target='_blank' rel='noopener' href='${esc(s.content_urls?.desktop?.page||WK)}'>Read the full article →</a></p></div><aside><h4>About this page</h4><ul><li>Pulled live from Wikipedia, so it is not curated by this site.</li><li>Text is available under CC BY-SA.</li></ul><button class='btn' data-live=''>Random dive</button></aside></div><section><div class='eye'>Keep falling</div><h2>Related on Wikipedia</h2><div class='grid'>${L.map(t=>`<a class='card' href='#live' data-live='${encodeURIComponent(t)}'><div><small>Wikipedia</small><h3>${esc(t)}</h3></div></a>`).join('')}</div></section></article>`;if(s.thumbnail){const i=new Image();i.alt='';i.onload=()=>{const b=$('#lim');if(b){b.innerHTML='';b.appendChild(i)}};i.src=s.thumbnail.source}scrollTo(0,0)}catch(e){if(location.hash!==my)return;app.innerHTML=`<div class='pg wrap'><section><div class='empty'>Deep Dive couldn’t reach Wikipedia. It needs open internet access, and some hosts block outside requests, so try opening this file locally or on your own site.<br><br><a class='chip' href='#explore'>Back to the archive</a></div></section></div>`}}
const rand=()=>{const cur=location.hash.slice(1),o=D.filter(x=>x.id!==cur);location.hash=o[Math.floor(Math.random()*o.length)].id};
function route(){const h=location.hash.slice(1)||"home",app=$("#app");let v;
try{if(byId[h]){if(hist[hist.length-1]!==h){hist.push(h);hist=hist.slice(-200);store.set("rh_hist",hist)}v=page(h);document.title=byId[h].t+" · The Rabbit Hole"}
else{document.title="The Rabbit Hole";const c=CATS.find(c=>slug(c)===h);
v=h==="live"?loadMsg():h==="home"?home():h==="explore"?list("Everything, so far","Explore",D,""):h==="categories"?cats():h==="collection"?collection():c?list(c,"Category",D.filter(x=>x.c===c),""):`<div class="pg wrap"><section><div class="empty">That page fell down a hole. <a class="chip" href="#home">Go home</a></div></section></div>`}}
catch(e){v=`<div class="pg wrap"><section><div class="empty">Something went wrong loading this page. <a class="chip" href="#home">Go home</a></div></section></div>`}
app.innerHTML=v;scrollTo(0,0);document.querySelectorAll("[data-n]").forEach(a=>a.classList.toggle("on",a.dataset.n===h||(h==="collection"&&a.dataset.n==="collection")));
if(h==="live")liveView();const cv=$("#cv");if(cv)bg(cv);const en=$("#enter");if(en)en.onclick=rand}
addEventListener("hashchange",route);
document.addEventListener("click",e=>{const b=e.target.closest("[data-bm]");
if(b){const i=b.dataset.bm;bm=bm.includes(i)?bm.filter(x=>x!==i):[...bm,i];store.set("rh_bm",bm);b.textContent=bm.includes(i)?"✓ Saved":"+ Save to collection"}
const LV=e.target.closest("[data-live]");if(LV){e.preventDefault();live=LV.dataset.live?{t:decodeURIComponent(LV.dataset.live)}:null;store.set("rh_live",live);if(location.hash==="#live")route();else location.hash="live"}const c=e.target.closest("[data-clear]");if(c){if(c.dataset.clear==="hist"){hist=[];store.set("rh_hist",hist)}else{bm=[];store.set("rh_bm",bm)}route()}
if(!e.target.closest(".sw"))$("#res").hidden=true;else if(e.target.closest("#res a")){$("#res").hidden=true;$("#q").value=""}});
$("#rnd").onclick=rand;$("#sur").onclick=rand;
const si=$("#q"),sr=$("#res");
si.addEventListener("input",()=>{const q=si.value.trim().toLowerCase();if(!q){sr.hidden=true;return}
const m=D.map(x=>({x,s:(x.t.toLowerCase().includes(q)?3:0)+(x.c.toLowerCase().includes(q)?2:0)+(x.d.toLowerCase().includes(q)?1:0)})).filter(o=>o.s).sort((a,b)=>b.s-a.s).slice(0,6);
sr.innerHTML=m.length?m.map(o=>`<a href="#${o.x.id}"><b>${o.x.t}</b><small>${o.x.c}</small></a>`).join(""):"<p>No matches. Try “signal” or “ocean”.</p>";sr.hidden=false});
si.addEventListener("keydown",e=>{if(e.key==="Escape"){sr.hidden=true;si.blur()}if(e.key==="Enter"){const a=sr.querySelector("a");if(a){location.hash=a.getAttribute("href").slice(1);sr.hidden=true;si.value=""}}});
route();
</script></body></html>
