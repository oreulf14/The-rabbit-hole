.rank a{display:flex;gap:18px;align-items:baseline;padding:16px 0;border-bottom:1px solid var(--ln);transition:padding .2s}.rank a:hover{padding-left:10px}.rank b{color:var(--ac);font:600 14px monospace}.rank span{color:var(--mu);font-size:13px;margin-left:auto}
.chips{display:flex;flex-wrap:wrap;gap:10px}.chip{border:1px solid var(--ln);border-radius:999px;padding:8px 16px;font-size:14px;color:var(--mu);transition:.2s}.chip:hover{color:var(--tx);border-color:var(--ac)}
.art{padding-top:48px}.art h1{font-size:clamp(34px,6vw,60px);margin:10px 0 16px}.lead{font-size:20px;color:var(--mu);max-width:60ch}
.himg{border-radius:14px;overflow:hidden;border:1px solid var(--ln);margin:28px 0}.himg svg,.himg img{display:block;width:100%;height:clamp(160px,30vw,280px)}.himg img{object-fit:cover}
